#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$script_dir/lib/freebsd.sh"

require_freebsd
require_root

sysrc ipv6_activate_all_interfaces=NO
sysrc ipv6_network_interfaces=none
sysrc ipv6_gateway_enable=NO
sysrc rtsold_enable=NO

sysctl net.inet6.ip6.forwarding=0
sysctl net.inet6.ip6.accept_rtadv=0

echo "IPv6 boot configuration is disabled. Reboot to mark all interfaces IFDISABLED."
