# Set the interface, SSID, and passphrase before installing as
# /etc/hostapd.conf.
interface=wlan1
driver=bsd
ssid=
wpa_passphrase=
channel=13
country_code=AZ
logger_syslog=-1
logger_syslog_level=2
logger_stdout=-1
logger_stdout_level=2
ctrl_interface=/var/run/hostapd
ctrl_interface_group=wheel
hw_mode=g
ieee80211n=1
auth_algs=1
ignore_broadcast_ssid=0
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
